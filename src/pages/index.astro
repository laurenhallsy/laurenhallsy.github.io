---
import SocialList from "@/components/SocialList.astro";
import PageLayout from "@/layouts/Base.astro";

const highlights = [
	{
		stat: "D1",
		label: "Lacrosse goalie",
		text: "Division I women's lacrosse at the University of Denver. Every day is a lesson in reading patterns, staying composed, and resetting after a goal.",
	},
	{
		stat: "7,745",
		label: "Shots modeled",
		text: "Built an expected-goals (xG) model on Premier Lacrosse League data in R and found that shot angle, not distance, predicts goals.",
	},
	{
		stat: "Dean's List",
		label: "Academics",
		text: "Business Information & Analytics major with a Finance minor, balancing a full D1 schedule with the classroom.",
	},
];

const explore = [
	{ href: "/skills/", title: "Skills", text: "R, SQL, Python, Tableau — plus the soft skills a goalie learns in the crease." },
	{ href: "/projects/", title: "Projects", text: "The PLL shot-quality model and other analytics and database work." },
	{ href: "/experience/", title: "Experience", text: "Division I athletics, outbound sales calls, and customer-facing work." },
	{ href: "/education/", title: "Education", text: "The DU courses that shaped how I think about data, markets, and teams." },
	{ href: "/about/", title: "Beyond the Classroom", text: "Youth lacrosse, side projects, and what I do for fun." },
];
---

<PageLayout meta={{ title: "Home" }}>
	<section class="grid items-center gap-10 sm:grid-cols-[1fr_240px]">
		<div>
			<p class="eyebrow">University of Denver · Class of 2027</p>
			<h1 class="text-accent-2 mt-3 text-4xl font-bold tracking-tight sm:text-5xl">
				Hi, I'm Lauren Hall.
			</h1>
			<p class="text-accent mt-5 border-s-4 border-current ps-4 text-lg font-semibold">
				I'm a Division I goalie who reads the game through data, and I want to bring that same
				preparation, composure, and competitive drive to helping customers win with AI and SaaS.
			</p>
			<p class="text-muted mt-5 max-w-xl">
				I study Business Information &amp; Analytics with a Finance minor, and I'm pursuing a
				Sales Development Representative (SDR) role at an AI or SaaS company after graduation.
				I grew up in the Bay Area around technology and startups, and I've spent my college years
				learning to turn messy data into clear stories people can act on.
			</p>
			<div class="mt-7 flex flex-wrap gap-3">
				<a class="btn" href="/projects/">See my work →</a>
				<a class="btn-ghost" href="/Lauren_Hall_SDR_Resume.pdf" download="Lauren_Hall_SDR_Resume.pdf"> Resume ↓</a>
				<a class="btn-ghost" href="mailto:lauren@chezhall.com">Get in touch</a>
			</div>
		</div>
		<div class="order-first mx-auto w-44 sm:order-none sm:w-full">
			<img
				alt="Black-and-white portrait of Lauren Hall smiling"
				class="aspect-[4/5] w-full rotate-2 rounded-2xl object-cover shadow-xl ring-4 ring-white dark:ring-white/10"
				height="916"
				src="/images/headshot.jpg"
				width="814"
			/>
		</div>
	</section>

	<h2 class="section-title">Highlights</h2>
	<ul class="grid gap-4 sm:grid-cols-3" role="list">
		{
			highlights.map((h) => (
				<li class="card">
					<p class="text-accent text-3xl font-bold">{h.stat}</p>
					<p class="text-accent-2 mt-1 font-mono text-xs font-semibold tracking-widest uppercase">
						{h.label}
					</p>
					<p class="text-muted mt-3 text-sm">{h.text}</p>
				</li>
			))
		}
	</ul>

	<h2 class="section-title">What I'm looking for</h2>
	<div class="card grid gap-6 sm:grid-cols-2">
		<div>
			<p class="text-accent-2 font-semibold">Role</p>
			<p class="text-muted mt-1 text-sm">
				Full-time Sales Development Representative (SDR/BDR) starting after graduation in 2027.
			</p>
		</div>
		<div>
			<p class="text-accent-2 font-semibold">Where</p>
			<p class="text-muted mt-1 text-sm">
				AI and SaaS companies with a strong product and a coaching culture.
			</p>
		</div>
		<div>
			<p class="text-accent-2 font-semibold">What I bring</p>
			<p class="text-muted mt-1 text-sm">
				Coachability, resilience after a bad rep, and the analytical background to understand a
				customer's data and business problems.
			</p>
		</div>
		<div>
			<p class="text-accent-2 font-semibold">How I work</p>
			<p class="text-muted mt-1 text-sm">
				Prepare relentlessly, track the numbers, take feedback fast, and stay calm when it counts.
			</p>
		</div>
	</div>

	<h2 class="section-title">Explore</h2>
	<ul class="grid gap-3 sm:grid-cols-2" role="list">
		{
			explore.map((e, i) => (
				<li class:list={[i === explore.length - 1 && "sm:col-span-2"]}>
					<a class="card group block h-full transition hover:-translate-y-0.5 hover:shadow-md" href={e.href}>
						<p class="text-accent-2 font-semibold group-hover:underline">{e.title} →</p>
						<p class="text-muted mt-1 text-sm">{e.text}</p>
					</a>
				</li>
			))
		}
	</ul>

	<h2 class="section-title">Contact</h2>
	<div class="card flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
		<div class="text-sm">
			<p>
				<span class="text-accent-2 font-semibold">Email:</span>{" "}
				<a class="cactus-link" href="mailto:lauren@chezhall.com">lauren@chezhall.com</a>
			</p>
			<p class="mt-1">
				<span class="text-accent-2 font-semibold">LinkedIn:</span>{" "}
				<a class="cactus-link" href="https://www.linkedin.com/in/laurenhalll/" rel="noreferrer" target="_blank"
					>linkedin.com/in/laurenhalll</a
				>
			</p>
			<p class="mt-1">
				<span class="text-accent-2 font-semibold">Resume:</span>{" "}
				<a class="cactus-link" href="/Lauren_Hall_SDR_Resume.pdf" download="Lauren_Hall_SDR_Resume.pdf">Download PDF</a>
			</p>
			<p class="mt-1"><span class="text-accent-2 font-semibold">Based in:</span> Denver, CO · from the San Francisco Bay Area</p>
		</div>
		<SocialList />
	</div>
</PageLayout>
