---
import PageLayout from "@/layouts/Base.astro";

const groups = [
	{
		area: "Analytics & Information Systems",
		courses: [
			{
				name: "Sports Analytics",
				learned:
					"Applied statistical modeling to real sports data: NFL play-by-play through nflfastR, NBA data, clustering, and generalized linear and additive models (GLMs and GAMs). My final project was the PLL expected-goals model.",
				tags: ["R", "nflfastR", "Clustering", "GLMs", "GAMs", "Logistic regression"],
				link: { href: "/projects/#pll-xg", label: "Final project" },
			},
			{
				name: "Data Warehousing",
				learned:
					"Dimensional modeling and analytics architecture: business processes, grain, and fact and dimension tables. My team is building a star-schema data mart for a surf shop.",
				tags: ["Star schema", "Dimensional modeling", "SQL"],
				link: { href: "/projects/#surf-data-mart", label: "Team project" },
			},
			{
				name: "INFO 3240 · Database Design & Development",
				learned:
					"Relational design, normalization, SQL Server, and building an application on top of a database. I built an eight-table dealership system with a VB.NET Windows Forms front end and SSRS reports.",
				tags: ["SQL Server", "VB.NET", "SSRS", "Normalization"],
				link: { href: "/projects/#ferrari-db", label: "Course project" },
			},
			{
				name: "INFO 3140",
				learned:
					"Database and application fundamentals. This is where I built my first version of the dealership database in SQLite.",
				tags: ["SQLite", "SQL"],
			},
			{
				name: "Project Management",
				learned:
					"Project charters, scope, stakeholder management, and planning. Our team runs a simulated project and presents to classmate stakeholders for charter approval.",
				tags: ["Project charters", "Stakeholder management", "Scope"],
			},
		],
	},
	{
		area: "Finance",
		courses: [
			{
				name: "Financial Markets",
				learned: "How markets and institutions work, including derivatives, futures, swaps, and mortgage products.",
				tags: ["Derivatives", "Futures", "Swaps", "Mortgage products"],
			},
			{
				name: "Investments",
				learned:
					"Investment analysis and bank management, with a focus on interest rate risk and how institutions manage it.",
				tags: ["Interest rate risk", "Bank management", "Portfolio concepts"],
			},
			{
				name: "A Walk Down Wall Street",
				learned:
					"An application-based finance course that ends with a December trip to New York City to see the financial industry up close.",
				tags: ["Capital markets", "Industry exposure", "NYC trip"],
			},
		],
	},
	{
		area: "Programming & Self-Study",
		courses: [
			{
				name: "Stanford CS106A · Programming Methodology (self-study)",
				learned:
					"Python fundamentals: decomposition, control flow, data structures, and problem solving. I built a small search engine as a project.",
				tags: ["Python", "Problem solving"],
			},
			{
				name: "AI-assisted development (self-taught)",
				learned:
					"Using AI coding tools to prototype apps and analysis faster, including React prototypes and this site.",
				tags: ["AI tools", "React", "Git & GitHub"],
			},
		],
	},
	{
		area: "Breadth",
		courses: [
			{
				name: "Geography",
				learned:
					"Earth systems: the El Niño–Southern Oscillation (ENSO), coastal processes, climate change, and soil science.",
				tags: ["Climate systems", "ENSO", "Coastal processes"],
			},
		],
	},
];
---

<PageLayout meta={{ title: "Education", description: "Lauren Hall's education and key coursework" }}>
	<p class="eyebrow">Education</p>
	<h1 class="page-title">University of Denver</h1>

	<div class="card mb-4 grid gap-4 sm:grid-cols-3">
		<div>
			<p class="text-muted font-mono text-xs tracking-widest uppercase">Major</p>
			<p class="text-accent-2 mt-1 font-semibold">Business Information &amp; Analytics</p>
		</div>
		<div>
			<p class="text-muted font-mono text-xs tracking-widest uppercase">Minor</p>
			<p class="text-accent-2 mt-1 font-semibold">Finance</p>
		</div>
		<div>
			<p class="text-muted font-mono text-xs tracking-widest uppercase">Graduation</p>
			<p class="text-accent-2 mt-1 font-semibold">2027 · Daniels College of Business</p>
		</div>
	</div>
	<div class="mb-12 flex flex-wrap gap-2">
		<span class="pill">Dean's List</span>
		<span class="pill">NCAA Division I student-athlete</span>
	</div>

	{
		groups.map((g) => (
			<section>
				<h2 class="section-title">{g.area}</h2>
				<ul class="space-y-4" role="list">
					{g.courses.map((c) => (
						<li class="card">
							<div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
								<h3 class="text-accent-2 font-bold">{c.name}</h3>
								{c.link && (
									<a class="cactus-link text-accent text-xs font-semibold" href={c.link.href}>
										{c.link.label} →
									</a>
								)}
							</div>
							<p class="text-muted mt-2 text-sm">{c.learned}</p>
							<div class="mt-3 flex flex-wrap gap-1.5">
								{c.tags.map((t) => (
									<span class="pill">{t}</span>
								))}
							</div>
						</li>
					))}
				</ul>
			</section>
		))
	}
</PageLayout>
